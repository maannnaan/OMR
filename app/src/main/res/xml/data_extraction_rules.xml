<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and phone-to-phone transfers (Android 12 and later): everything but the Lecturer.bd session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lecturer_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lecturer_auth.xml" />
    </device-transfer>
</data-extraction-rules>
